{
  "include": ["src/", "test/*.ts"],
  "compileOnSave": false,
  "compilerOptions": {
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise"],
    "module": "nodenext",
    "target": "es2024",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
        "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "exclude": ["node_modules"]
}
